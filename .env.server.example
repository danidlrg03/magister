# Server only. Never add these values to REACT_APP_* variables.
GROQ_API_KEY=
# Select an available chat model in your Groq account.
GROQ_MODEL=
# Same Firebase web API key as the frontend, for validating user sessions.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# Comma-separated Firebase Authentication UIDs permitted to spend API credits.
ALLOWED_FIREBASE_UIDS=
