# Server only. Never add these values to REACT_APP_* variables.
# Select groq or openai. If omitted, existing Groq configuration still works.
AI_PROVIDER=groq
# A model available in your account. OpenAI requires Chat Completions + Structured Outputs.
AI_MODEL=
AI_MAX_OUTPUT_TOKENS=8192
GROQ_API_KEY=
OPENAI_API_KEY=
# Legacy fallback for Groq when AI_MODEL is blank.
GROQ_MODEL=
# Same Firebase web API key as the frontend, for validating user sessions.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# Comma-separated Firebase Authentication UIDs permitted to spend API credits.
ALLOWED_FIREBASE_UIDS=
